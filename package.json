{
  "name": "datapermit",
  "version": "1.0.0",
  "description": "A Next.js application for discovering, publishing, licensing, and accessing specialist AI evaluation datasets. Designed for Vercel and Monad's Trust, Identity & AI Infrastructure track.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "contracts:compile": "tsx scripts/compile.ts",
    "contracts:deploy": "tsx --env-file=.env.local scripts/deploy.ts",
    "format": "prettier --write src scripts tests README.md plan.md playwright.config.ts next.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aurora-is-near/intents-connect": "^7.24.2",
    "@category-labs/mera": "^0.2.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "solc": "^0.8.37",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
